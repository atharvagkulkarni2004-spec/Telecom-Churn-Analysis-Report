table cleaned_telco_churn
	lineageTag: 18450771-5b35-4b5a-a367-22dbb7cc11e0

	measure 'Churn Rate' = ```
			
			DIVIDE(
			    CALCULATE(COUNT('cleaned_telco_churn'[Churn]), 'cleaned_telco_churn'[Churn] = "Yes"),
			    COUNT('cleaned_telco_churn'[Churn])
			)
			
			```
		lineageTag: 25922d41-579f-4af9-a7d9-7bcb193849e7

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Revenue' = ```
			SUM(cleaned_telco_churn[MonthlyCharges])
			
			```
		lineageTag: 77621c98-1fc6-487b-8a56-88e547e36bbb

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Chuurn rate' = ```
			
			DIVIDE(
			    CALCULATE(COUNT(cleaned_telco_churn[CustomerID]), cleaned_telco_churn[Churn] = "Yes"),
			    COUNT(cleaned_telco_churn[CustomerID])
			)
			
			```
		lineageTag: 97fdb1eb-8922-4876-8fe4-6dfe7a9def5e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Churn Count' =
			
			CALCULATE(
			    COUNT(cleaned_telco_churn[customerID]),
			    cleaned_telco_churn[Churn] = "Yes"
			)
		formatString: 0
		lineageTag: 467253fc-cc10-4de5-84e3-6f43d47eeb2d

	measure 'Churn Rate %' =
			
			DIVIDE(
			    [Churn Count],
			    COUNT(cleaned_telco_churn[customerID])
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 65b31c80-26e2-482e-bbe5-421f991135ca

	measure 'Total Customers' = DISTINCTCOUNT(cleaned_telco_churn[CustomerID])
		formatString: 0
		lineageTag: 9b21bed1-0981-40e9-8878-dfcb963f49a0

	measure 'Total Churned' =
			
			CALCULATE(
			    DISTINCTCOUNT(cleaned_telco_churn[CustomerID]),
			    cleaned_telco_churn[Churn] = "Yes"
			)
		formatString: 0
		lineageTag: be40adb6-5b77-48bb-b12e-8cb126f07712

