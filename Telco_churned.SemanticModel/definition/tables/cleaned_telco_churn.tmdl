		annotation GroupingDesignState = {"Version":0,"Sources":[{"Name":"c","Entity":"cleaned_telco_churn"}],"GroupedColumns":[{"Column":{"Expression":{"SourceRef":{"Source":"c"}},"Property":"MonthlyCharges"}}],"BinItem":{"Expression":{"Floor":{"Expression":{"Column":{"Expression":{"SourceRef":{"Source":"c"}},"Property":"MonthlyCharges"}},"Size":20.0}}}}

