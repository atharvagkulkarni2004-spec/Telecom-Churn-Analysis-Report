	column Monthly_Charges_Group =
			
			SWITCH(
			    TRUE(),
			    cleaned_telco_churn[MonthlyCharges] <= 30, "Low (0-30)",
			    cleaned_telco_churn[MonthlyCharges] <= 60, "Medium (31-60)",
			    cleaned_telco_churn[MonthlyCharges] <= 90, "High (61-90)",
			    "Very High (90+)"
			)
		lineageTag: a0b0541d-2921-420e-956b-04e1beee1952
