	column 'MonthlyCharges (bins)' =
			IF(
				ISBLANK('cleaned_telco_churn'[MonthlyCharges]),
				BLANK(),
				IF(
					'cleaned_telco_churn'[MonthlyCharges] >= 0,
					ROUNDDOWN('cleaned_telco_churn'[MonthlyCharges] / 20, 0) * 20,
					ROUNDUP('cleaned_telco_churn'[MonthlyCharges] / 20, 0) * 20
				)
			)
		lineageTag: 8a5718d6-3358-4a3d-8aaf-209ab71423c2
		summarizeBy: none

